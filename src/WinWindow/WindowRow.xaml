<UserControl x:Class="WinWindow.WindowRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
  <Border x:Name="CardFrame" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource CardLine}" BorderThickness="1" CornerRadius="10" Padding="10,7"
    ContextMenuOpening="RowMenu_Opening">
    <Border.ContextMenu>
      <ContextMenu x:Name="RowMenu">
        <MenuItem x:Name="RememberItem" Header="记住设置（下次自动应用）" IsCheckable="True" Click="Remember_Click"/>
        <MenuItem Header="恢复窗口原样" Click="Reset_Click"/>
        <Separator/>
        <MenuItem Header="复制窗口信息" Click="Copy_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid x:Name="RowBody">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="90"/>
        <ColumnDefinition Width="78"/>
        <ColumnDefinition Width="46"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="30"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="TitleButton" Style="{StaticResource RowTitleButton}" Click="Title_Click" ToolTip="{Binding Title}" IsEnabled="{Binding CanOperate}">
        <Grid Margin="0,1,8,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WindowAvatar}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleLabel" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock Text="{Binding ProcessName}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="RowState" Style="{StaticResource MutedText}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Button>

      <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
        VerticalAlignment="Center" Margin="4,0,4,0" ValueChanged="Opacity_Changed" PreviewMouseWheel="Slider_Wheel"
        IsEnabled="{Binding IsAvailable}" ToolTip="拖动调整不透明度，选中滑块后可用滚轮微调" AutomationProperties.Name="不透明度"/>

      <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
        <Button x:Name="OpacityDisplayButton" Style="{StaticResource QuietButton}" Padding="3,3" MinHeight="24" HorizontalContentAlignment="Right"
          FontSize="12" Click="EditOpacity_Click" IsEnabled="{Binding IsAvailable}" ToolTip="点击输入精确百分比" AutomationProperties.Name="编辑不透明度百分比"/>
        <Grid x:Name="OpacityEditHost" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="12"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="OpacityNumber" MinHeight="24" Padding="2,2" TextAlignment="Right" FontSize="11.5"
            IsEnabled="{Binding IsAvailable}" GotKeyboardFocus="Number_Focus" TextChanged="Number_Changed"
            LostKeyboardFocus="Number_Blur" KeyDown="Number_Key" AutomationProperties.Name="不透明度百分比"/>
          <TextBlock Grid.Column="1" Text="%" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Grid>

      <ToggleButton x:Name="BackgroundToggle" Width="Auto" MinWidth="30" Grid.Column="3" Style="{StaticResource IconToggle}"
        Click="Background_Click" IsEnabled="{Binding CanOperate}"
        AutomationProperties.Name="后台保持" ToolTip="后台保持：切到其他应用后继续维持窗口激活通知">
        <StackPanel Orientation="Horizontal" Margin="5,0">
        <Path Data="M9,2 L4,8.8 L8,8.8 L7,14.5 L12,7.8 L8,7.8 Z"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
          <TextBlock x:Name="BackgroundLabel" Text="后台保持" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </ToggleButton>

      <Button x:Name="ParkButton" Grid.Column="4" Style="{StaticResource RowIconButton}" Click="Park_Click" IsEnabled="{Binding CanOperate}">
        <Path x:Name="ParkIcon" Data="M3,13 L13,13 M8,2.5 L8,9.8 M5,7 L8,10 L11,7"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
      </Button>

      <ToggleButton x:Name="ThroughButton" Grid.Column="5" Style="{StaticResource IconToggle}" Click="Through_Click" IsEnabled="{Binding CanOperate}"
        ToolTip="鼠标穿透" AutomationProperties.Name="鼠标穿透">
        <Path Data="M3.5,2 L3.5,12.8 L6.4,9.8 L8.6,14.2 L10.3,13.3 L8.1,8.9 L12.4,8.9 Z"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
      </ToggleButton>

      <ToggleButton x:Name="PinButton" Grid.Column="6" Style="{StaticResource IconToggle}" Click="Pin_Click" AutomationProperties.Name="窗口置顶">
        <Path x:Name="PinIcon" Data="M5.2,2.2 L10.8,2.2 M6,2.2 L6,6.8 L3.6,9.5 L12.4,9.5 L10,6.8 L10,2.2 M8,9.5 L8,14.5"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
      </ToggleButton>

      <Button x:Name="RemoveButton" Grid.Column="7" Style="{StaticResource DangerIconButton}" Click="Remove_Click"
        ToolTip="取消置顶并移出管理，不关闭目标程序" AutomationProperties.Name="移出管理">
        <Path Data="M4,4 L12,12 M12,4 L4,12"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
      </Button>

      <Button x:Name="GhostGuardButton" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="36,5,0,1" HorizontalAlignment="Left"
        Style="{StaticResource WarningPillButton}" Visibility="Collapsed" Click="EnableThrough_Click"
        Content="启用鼠标穿透" ToolTip="窗口接近透明，启用后鼠标可以点到下方的窗口"/>
    </Grid>
  </Border>
</UserControl>
