<UserControl x:Class="WinWindow.WindowRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
  <Grid x:Name="RowBody" Background="Transparent" MinHeight="62" ContextMenuOpening="RowMenu_Opening">
    <Grid.ContextMenu>
      <ContextMenu x:Name="RowMenu">
        <MenuItem x:Name="RememberItem" Header="记住设置" IsCheckable="True" Click="Remember_Click"/>
        <MenuItem Header="恢复原样" Click="Reset_Click"/>
        <Separator/>
        <MenuItem Header="复制窗口信息" Click="Copy_Click"/>
      </ContextMenu>
    </Grid.ContextMenu>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="100"/>
      <ColumnDefinition Width="180"/>
      <ColumnDefinition Width="68"/>
      <ColumnDefinition Width="36"/><ColumnDefinition Width="36"/>
      <ColumnDefinition Width="36"/><ColumnDefinition Width="36"/>
    </Grid.ColumnDefinitions>
    <Button x:Name="TitleButton" Style="{StaticResource RowTitleButton}" Click="Title_Click" ToolTip="{Binding Title}" IsEnabled="{Binding CanOperate}">
      <StackPanel Margin="0,4,16,4">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock Text="{Binding ProcessName}" Style="{StaticResource MutedText}"/>
          <TextBlock x:Name="RowState" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Button>
    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
      VerticalAlignment="Center" Margin="10,0,10,0" ValueChanged="Opacity_Changed" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="不透明度"/>
    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="2,0,8,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
      <TextBox x:Name="OpacityNumber" MinHeight="28" Padding="2,4" TextAlignment="Right" FontSize="12"
        IsEnabled="{Binding IsAvailable}" GotKeyboardFocus="Number_Focus" TextChanged="Number_Changed"
        LostKeyboardFocus="Number_Blur" KeyDown="Number_Key" AutomationProperties.Name="不透明度百分比"/>
      <TextBlock Grid.Column="1" Text="%" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    <Button x:Name="ParkButton" Grid.Column="3" Style="{StaticResource RowIconButton}" Click="Park_Click" IsEnabled="{Binding CanOperate}"/>
    <ToggleButton x:Name="ThroughButton" Grid.Column="4" Style="{StaticResource IconToggle}" Click="Through_Click" IsEnabled="{Binding CanOperate}"
      ToolTip="鼠标穿透" AutomationProperties.Name="鼠标穿透">
      <Path Data="M3,1 L3,14 L7,10 L10,16 L12,15 L9,9 L15,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" Width="16" Height="16"/>
    </ToggleButton>
    <ToggleButton x:Name="PinButton" Grid.Column="5" Style="{StaticResource IconToggle}" Click="Pin_Click" AutomationProperties.Name="窗口置顶">
      <Path Data="M5,2 L12,2 M6,2 L6,7 L3,10 L3,11 L14,11 L14,10 L11,7 L11,2 M8.5,11 L8.5,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" Width="18" Height="18"/>
    </ToggleButton>
    <Button x:Name="RemoveButton" Grid.Column="6" Style="{StaticResource RowIconButton}" Content="&#xE8BB;" Click="Remove_Click"
      ToolTip="取消置顶并移出管理，不关闭目标程序" AutomationProperties.Name="移出管理"/>
  </Grid>
</UserControl>
