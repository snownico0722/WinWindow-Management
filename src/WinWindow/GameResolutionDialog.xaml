<Window x:Class="WinWindow.GameResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.GameResolutionTitle}"
        Width="590" Height="570" MinWidth="540" MinHeight="500"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <TextBlock Text="{DynamicResource Text.GameResolutionTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
        <TextBlock Text="{DynamicResource Text.GameResolutionIntro}" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource CardLine}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="{DynamicResource Text.GameResolutionOutputTitle}" FontWeight="SemiBold" FontSize="13.5"/>
              <TextBlock x:Name="CurrentModeText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,10"/>
              <TextBlock Text="{DynamicResource Text.GameResolutionSelectMode}" Margin="0,0,0,5"/>
              <ComboBox x:Name="ModeBox" MinHeight="32" Padding="6,4" SelectionChanged="ModeBox_SelectionChanged"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="ApplyOutputButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Text.GameResolutionApplyOutput}" Click="ApplyOutput_Click" Margin="0,0,8,0"/>
                <Button x:Name="RestoreOutputButton" Content="{DynamicResource Text.GameResolutionRestoreOutput}" Click="RestoreOutput_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource CardLine}" BorderThickness="1" CornerRadius="9" Padding="14">
            <StackPanel>
              <TextBlock Text="{DynamicResource Text.GameResolutionUnityTitle}" FontWeight="SemiBold" FontSize="13.5"/>
              <TextBlock Text="{DynamicResource Text.GameResolutionUnityHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <TextBox x:Name="ArgsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Padding="8" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Paper}" FontFamily="Consolas"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="CopyUnityArgsButton" Content="{DynamicResource Text.GameResolutionCopyArgs}" Click="CopyUnityArgs_Click" Margin="0,0,8,0"/>
              </StackPanel>
              <TextBlock x:Name="UnityLaunchHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Grid.Column="1" Content="{DynamicResource Text.Close}" IsCancel="True" MinWidth="82"/>
      </Grid>
    </Grid>
  </Border>
</Window>
