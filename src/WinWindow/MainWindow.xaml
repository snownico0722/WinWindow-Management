<Window x:Class="WinWindow.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WinWindow"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Icon="Assets/WinWindow.ico" Title="WinWindow Management" Width="580" Height="500" MinWidth="500" MinHeight="380"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border x:Name="ShellFrame" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource Paper}">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition x:Name="HeaderRow" Height="44"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

   <Grid x:Name="Header" Margin="10,0,8,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Button x:Name="BrandArea" Style="{StaticResource RowTitleButton}" Click="Brand_Click" Padding="6,4" HorizontalAlignment="Left"
      ToolTip="{DynamicResource Text.CollapseHint}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
      PreviewMouseLeftButtonDown="Brand_Down" PreviewMouseMove="Brand_Move" PreviewMouseLeftButtonUp="Brand_Up"
      LostMouseCapture="Brand_LostCapture">
     <Button.ContextMenu>
      <ContextMenu>
       <MenuItem Header="{DynamicResource Text.Settings}" Click="CompactSettings_Click"/>
       <MenuItem Header="{DynamicResource Text.Arrange}" Click="Arrange_Click"/>
       <MenuItem Header="{DynamicResource Text.RestoreAll}" Click="RecoverAll_Click"/>
       <Separator/>
       <MenuItem Header="{DynamicResource Text.Quit}" Click="Quit_Click"/>
      </ContextMenu>
     </Button.ContextMenu>
     <Grid VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image Width="22" Height="22" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" x:Name="BrandTitleText" Text="WinWindow" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <Border Grid.Column="2" x:Name="BrandCollapseHint" Background="{DynamicResource Surface}" CornerRadius="4" Padding="4,2" Margin="7,0,0,0" VerticalAlignment="Center">
       <Path x:Name="BrandHintIcon" Data="M2,7.5 L7.5,2 M7.5,2 L3.5,2 M7.5,2 L7.5,6"
         Stroke="{DynamicResource Muted}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9"/>
      </Border>
     </Grid>
    </Button>

    <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <ToggleButton x:Name="OwnPinBox" Style="{StaticResource IconToggle}" Width="30" Height="28" Click="OwnPin_Click" ToolTip="{DynamicResource Text.PinManager}" AutomationProperties.Name="{DynamicResource Text.PinThisWindow}">
      <Path x:Name="OwnPinIcon" Data="M5.2,2.2 L10.8,2.2 M10,2.2 L10,6.8 L12.4,9.5 L9.6,9.5 M6,2.2 L6,4.4 M3.6,9.5 L6.8,9.5 M8,11.2 L8,14.5 M2.5,2.5 L13.5,13.5"
        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
        StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15"/>
     </ToggleButton>
     <ToggleButton x:Name="SettingsButton" Style="{StaticResource IconToggle}" Width="32" ToolTip="{DynamicResource Text.Settings}" AutomationProperties.Name="{DynamicResource Text.Settings}" Click="SettingsButton_Click">
      <Path Data="M2.5,4.5 L8.5,4.5 M11.5,4.5 L13.5,4.5 M10,2.8 L10,6.2 M2.5,11.5 L4.5,11.5 M7.5,11.5 L13.5,11.5 M6,9.8 L6,13.2"
        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
        StrokeThickness="1.5" StrokeStartLineCap="Round" Width="15" Height="15"/>
     </ToggleButton>
     <Button Style="{StaticResource TitleButton}" ToolTip="{DynamicResource Text.Minimize}" AutomationProperties.Name="{DynamicResource Text.Minimize}" Click="Minimize_Click">
      <Path Data="M3.5,8 L12.5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Width="15" Height="15"/>
     </Button>
     <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" ToolTip="{DynamicResource Text.MaximizeOrRestore}" AutomationProperties.Name="{DynamicResource Text.ToggleMaximize}" Click="Maximize_Click">
      <Path Data="M3.5,3.5 L12.5,3.5 L12.5,12.5 L3.5,12.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" Width="15" Height="15"/>
     </Button>
     <Button Style="{StaticResource DangerTitleButton}" ToolTip="{DynamicResource Text.Close}" AutomationProperties.Name="{DynamicResource Text.Close}" Click="Close_Click">
      <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Width="15" Height="15"/>
     </Button>
    </StackPanel>

    <StackPanel x:Name="CompactActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button x:Name="CompactPickerButton" AutomationProperties.Name="{DynamicResource Text.DragToPin}" Style="{StaticResource RowIconButton}" ToolTip="{DynamicResource Text.DragToPinHint}"
       PreviewMouseLeftButtonDown="Picker_Down" PreviewMouseMove="Picker_Move" PreviewMouseLeftButtonUp="Picker_Up" LostMouseCapture="Picker_LostCapture">
      <Path Data="M8,2 L8,5 M8,11 L8,14 M2,8 L5,8 M11,8 L14,8 M8,6.5 A1.5,1.5 0 1 1 7.99,6.5"
        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Width="15" Height="15"/>
     </Button>
     <Button x:Name="CompactArrangeButton" Style="{StaticResource RowIconButton}" AutomationProperties.Name="{DynamicResource Text.Arrange}" ToolTip="{DynamicResource Text.Arrange}" Click="Arrange_Click">
      <Path Data="M2.5,3 L7,3 L7,7.5 L2.5,7.5 Z M9,3 L13.5,3 L13.5,7.5 L9,7.5 Z M2.5,9.5 L7,9.5 L7,13.5 L2.5,13.5 Z M9,9.5 L13.5,9.5 L13.5,13.5 L9,13.5 Z"
        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" Width="15" Height="15"/>
     </Button>
    </StackPanel>
   </Grid>

   <Grid x:Name="Workspace" Grid.Row="1" Margin="16,4,16,14">
    <Grid x:Name="WindowPage">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <Grid x:Name="Toolbar">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal">
       <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Click="Add_Click" ToolTip="{DynamicResource Text.ChooseOpenWindow}">
        <StackPanel Orientation="Horizontal">
         <Path Data="M7,2 L7,12 M2,7 L12,7" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.7" StrokeStartLineCap="Round" Width="13" Height="13" VerticalAlignment="Center"/>
         <TextBlock Text="{DynamicResource Text.AddWindow}" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
       </Button>
       <Button x:Name="PickerButton" Style="{StaticResource SplitDragButton}" Margin="1,0,0,0"
         PreviewMouseLeftButtonDown="Picker_Down" PreviewMouseMove="Picker_Move" PreviewMouseLeftButtonUp="Picker_Up"
         LostMouseCapture="Picker_LostCapture" Click="DragPicker_Click" ToolTip="{DynamicResource Text.DragAndRelease}">
        <StackPanel Orientation="Horizontal">
         <Path Data="M7,1.5 L7,4.2 M7,9.8 L7,12.5 M1.5,7 L4.2,7 M9.8,7 L12.5,7" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" Width="13" Height="13" VerticalAlignment="Center"/>
         <TextBlock Text="{DynamicResource Text.DragToPin}" Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
       </Button>
      </StackPanel>

      <Grid Grid.Column="1" Margin="10,0,6,0">
       <TextBlock x:Name="ManagedSummaryText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       <TextBox x:Name="SearchBox" Tag="{DynamicResource Text.FilterEscape}" TextChanged="Search_Changed" KeyDown="SearchBox_KeyDown" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource Text.SearchManaged}"/>
      </Grid>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
       <ToggleButton x:Name="SearchToggleButton" Style="{StaticResource IconToggle}" Margin="0,0,2,0" ToolTip="{DynamicResource Text.FilterShortcut}" Click="SearchToggle_Click" AutomationProperties.Name="{DynamicResource Text.OpenFilter}">
        <Path Data="M6.8,2.5 A4.3,4.3 0 1 0 6.8,11.1 A4.3,4.3 0 1 0 6.8,2.5 M10,10 L13.5,13.5"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Width="15" Height="15"/>
       </ToggleButton>
       <Button x:Name="MoreButton" Style="{StaticResource TitleButton}" Width="28" Height="28" ToolTip="{DynamicResource Text.MoreActions}" Click="More_Click">
        <Button.ContextMenu>
         <ContextMenu>
          <MenuItem x:Name="UnpinAllButton" Header="{DynamicResource Text.UnpinAll}" Click="UnpinAll_Click"/>
          <MenuItem Header="{DynamicResource Text.RestoreAll}" Click="RecoverAll_Click"/>
          <MenuItem Header="{DynamicResource Text.RefreshWindows}" Click="Refresh_Click"/>
          <Separator/>
          <MenuItem Header="{DynamicResource Text.Quit}" Click="Quit_Click"/>
         </ContextMenu>
        </Button.ContextMenu>
        <Path Data="M3,8 A1,1 0 1 1 3,8.01 M8,8 A1,1 0 1 1 8,8.01 M13,8 A1,1 0 1 1 13,8.01"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" Width="16" Height="16"/>
       </Button>
      </StackPanel>
     </Grid>

     <Grid Grid.Row="2">
      <ListBox x:Name="WindowList" ItemContainerStyle="{StaticResource CardListItem}" AutomationProperties.Name="{DynamicResource Text.ManagedWindows}">
       <ListBox.ItemTemplate><DataTemplate><local:WindowRow/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>

      <Border x:Name="EmptyStatePanel" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,2,0,4" IsHitTestVisible="False">
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Selection}" HorizontalAlignment="Center" Margin="0,0,0,10">
         <Path Data="M5.2,2.2 L10.8,2.2 M6,2.2 L6,6.8 L3.6,9.5 L12.4,9.5 L10,6.8 L10,2.2 M8,9.5 L8,14.5"
           Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
           Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="EmptyListText" Text="{DynamicResource Text.NoManagedWindows}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptyHintText" Text="{DynamicResource Text.AddWindowHint}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
     </Grid>

     <Border x:Name="DesktopFooter" Grid.Row="3" SizeChanged="DesktopFooter_SizeChanged" Margin="0,8,0,0" Padding="11,7" CornerRadius="9" Background="{DynamicResource Surface}">
      <DockPanel LastChildFill="False">
       <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Path Data="M2,2.5 L6.5,2.5 L6.5,7 L2,7 Z M8.5,2.5 L13,2.5 L13,7 L8.5,7 Z M2,9 L6.5,9 L6.5,13 L2,13 Z M8.5,9 L13,9 L13,13 L8.5,13 Z"
          Stroke="{DynamicResource Muted}" StrokeThickness="1.3" StrokeLineJoin="Round" Width="14" Height="14" VerticalAlignment="Center"/>
        <TextBlock x:Name="DesktopScopeLabel" Text="{DynamicResource Text.DesktopScope}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0"/>
        <Border Background="{DynamicResource Panel}" CornerRadius="6" Padding="2" Margin="8,0,0,0">
         <StackPanel x:Name="FooterModes" Orientation="Horizontal" AutomationProperties.Name="{DynamicResource Text.ArrangeMode}">
          <RadioButton Style="{StaticResource FooterModeChoice}" GroupName="FooterMode" Content="{DynamicResource Text.Manual}" Tag="Off" IsChecked="True" ToolTip="{DynamicResource Text.ManualHint}" AutomationProperties.Name="{DynamicResource Text.ManualArrange}" Checked="FooterMode_Checked"/>
          <RadioButton Style="{StaticResource FooterModeChoice}" GroupName="FooterMode" Content="{DynamicResource Text.Light}" Tag="LightAssist" ToolTip="{DynamicResource Text.LightHint}" AutomationProperties.Name="{DynamicResource Text.LightAssist}" Checked="FooterMode_Checked"/>
          <RadioButton Style="{StaticResource FooterModeChoice}" GroupName="FooterMode" Content="{DynamicResource Text.Full}" Tag="FullAssist" ToolTip="{DynamicResource Text.FullHint}" AutomationProperties.Name="{DynamicResource Text.FullAssist}" Checked="FooterMode_Checked"/>
          <RadioButton Style="{StaticResource FooterModeChoice}" GroupName="FooterMode" Content="{DynamicResource Text.Auto}" Tag="AutoFullAssist" ToolTip="{DynamicResource Text.AutoHint}" AutomationProperties.Name="{DynamicResource Text.AutoArrange}" Checked="FooterMode_Checked"/>
         </StackPanel>
        </Border>
       </StackPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="SnapshotButton" Content="{DynamicResource Text.CurrentSnapshot}" Margin="0,0,4,0" Style="{StaticResource QuietButton}" FontSize="12" Click="Snapshot_Click" ToolTip="{DynamicResource Text.CurrentSnapshotHint}"/>
        <Button x:Name="UndoArrangeButton" IsEnabled="False" Content="{DynamicResource Text.UndoArrange}" Margin="0,0,6,0" Style="{StaticResource QuietButton}" FontSize="12" Click="UndoLayout_Click" ToolTip="{DynamicResource Text.UndoArrangeHint}"/>
        <Button x:Name="ArrangeButton" Content="{DynamicResource Text.Arrange}" MinHeight="27" Padding="11,4" FontSize="12.5" Click="Arrange_Click" ToolTip="{DynamicResource Text.ArrangeHint}"/>
       </StackPanel>
      </DockPanel>
     </Border>
    </Grid>

    <Grid x:Name="SettingsPage" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Button Style="{StaticResource TitleButton}" Click="Back_Click" ToolTip="{DynamicResource Text.BackToList}" AutomationProperties.Name="{DynamicResource Text.Back}">
          <Path Data="M10.5,3 L5,8 L10.5,13 M5.5,8 L13.5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15"/>
        </Button>
        <TextBlock Text="{DynamicResource Text.Settings}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="122"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="0,2,8,0">
          <ListBox x:Name="SettingsNav" SelectionChanged="SettingsNav_Changed" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Text.SettingsCategories}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBoxItem Tag="GeneralSection" Content="{DynamicResource Text.General}"/>
            <ListBoxItem Tag="KeysSection" Content="{DynamicResource Text.Shortcuts}"/>
            <ListBoxItem Focusable="False" IsEnabled="False" IsHitTestVisible="False" Padding="5,4">
              <Border Background="{DynamicResource Line}" Height="1" Width="94"/>
            </ListBoxItem>
            <ListBoxItem Tag="LayoutSection" Content="{DynamicResource Text.DesktopLayout}"/>
            <ListBoxItem Tag="DataSection" Content="{DynamicResource Text.DataAndRecords}"/>
            <ListBoxItem Tag="PlacementSection" Content="{DynamicResource Text.PlacementLearning}"/>
            <ListBoxItem Tag="BehaviorSection" Content="{DynamicResource Text.BehaviorLearning}"/>
          </ListBox>
        </Border>
        <ScrollViewer x:Name="GeneralSection" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="18,0,10,14">
            <TextBlock Text="{DynamicResource Text.AppearanceStartup}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
            <TextBlock Text="{DynamicResource Text.Language}" Margin="0,4,0,2"/>
            <WrapPanel x:Name="LanguageChoices" Margin="0,0,0,6" AutomationProperties.Name="{DynamicResource Text.Language}">
              <RadioButton Style="{StaticResource SettingsChoice}" GroupName="LanguageChoices" Tag="system" Content="{DynamicResource Text.FollowSystem}" Click="Language_Changed"/>
              <RadioButton Style="{StaticResource SettingsChoice}" GroupName="LanguageChoices" Tag="zh-CN" Content="简体中文" Click="Language_Changed"/>
              <RadioButton Style="{StaticResource SettingsChoice}" GroupName="LanguageChoices" Tag="en" Content="English" Click="Language_Changed"/>
            </WrapPanel>
            <CheckBox x:Name="DarkBox" Content="{DynamicResource Text.DarkTheme}" Click="Settings_Click"/>
            <CheckBox x:Name="TrayBox" Content="{DynamicResource Text.ExitOnClose}" Click="Settings_Click"/>
            <CheckBox x:Name="StartupBox" Content="{DynamicResource Text.StartWithWindows}" Click="Startup_Click"/>
            <TextBlock Text="{DynamicResource Text.Feedback}" Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>
            <CheckBox x:Name="SoundBox" Content="{DynamicResource Text.PinSound}" Click="Settings_Click"/>
            <CheckBox x:Name="NotificationBox" Content="{DynamicResource Text.PinNotifications}" Click="Settings_Click"/>
            <TextBlock Text="{DynamicResource Text.ManagerZOrder}" Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>
            <CheckBox x:Name="FocusPinBox" Content="{DynamicResource Text.PinOnFocus}" Click="Settings_Click" ToolTip="{DynamicResource Text.PinOnFocusHint}"/>
            <CheckBox x:Name="AbsoluteBox" Content="{DynamicResource Text.KeepAbove}" Click="Settings_Click" ToolTip="{DynamicResource Text.KeepAboveHint}"/>
            <CheckBox x:Name="AggressiveBox" Content="{DynamicResource Text.AggressiveCheck}" Click="Settings_Click" ToolTip="{DynamicResource Text.AggressiveHint}"/>
            <TextBlock Text="{DynamicResource Text.BackgroundSection}" Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>
            <CheckBox x:Name="EnhancedBackgroundBox" Content="{DynamicResource Text.EnhancedBackground}" Click="Settings_Click" ToolTip="{DynamicResource Text.EnhancedBackgroundHint}"/>
            <CheckBox x:Name="LockCursorPosBox" Content="{DynamicResource Text.LockBackgroundCursor}" Click="Settings_Click" ToolTip="{DynamicResource Text.LockBackgroundCursorHint}"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="LayoutSection" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="18,0,10,14">
            <TextBlock Text="{DynamicResource Text.LayoutAlgorithm}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
            <WrapPanel x:Name="AlgorithmChoices" Margin="0,0,0,6">
              <RadioButton Style="{StaticResource SettingsChoice}" GroupName="AlgorithmChoices" Content="{DynamicResource Text.Smart}" Tag="Smart" Click="LayoutPreference_Click"/>
              <RadioButton Style="{StaticResource SettingsChoice}" GroupName="AlgorithmChoices" Content="{DynamicResource Text.Classic}" Tag="Classic" Click="LayoutPreference_Click"/>
            </WrapPanel>
            <StackPanel x:Name="SmartOptions">
              <TextBlock Text="{DynamicResource Text.LayoutStrength}" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
              <WrapPanel x:Name="StrengthChoices" Margin="0,0,0,6">
                <RadioButton Style="{StaticResource SettingsChoice}" GroupName="StrengthChoices" Content="{DynamicResource Text.Gentle}" Tag="Gentle" Click="LayoutPreference_Click"/>
                <RadioButton Style="{StaticResource SettingsChoice}" GroupName="StrengthChoices" Content="{DynamicResource Text.Balanced}" Tag="Balanced" Click="LayoutPreference_Click"/>
                <RadioButton Style="{StaticResource SettingsChoice}" GroupName="StrengthChoices" Content="{DynamicResource Text.Assertive}" Tag="Assertive" Click="LayoutPreference_Click"/>
              </WrapPanel>
              <CheckBox x:Name="VerticalFill" Content="{DynamicResource Text.VerticalFill}" Click="LayoutPreference_Click"/>
              <CheckBox x:Name="VideoBars" Content="{DynamicResource Text.VideoBars}" Click="LayoutPreference_Click"/>
              <WrapPanel x:Name="VideoChoices" Margin="0,0,0,6">
                <RadioButton Style="{StaticResource SettingsChoice}" GroupName="VideoChoices" Content="{DynamicResource Text.PreferShrink}" Tag="Shrink" Click="LayoutPreference_Click"/>
                <RadioButton Style="{StaticResource SettingsChoice}" GroupName="VideoChoices" Content="{DynamicResource Text.PreferEnlarge}" Tag="Expand" Click="LayoutPreference_Click"/>
              </WrapPanel>
              <Expander Header="{DynamicResource Text.AdvancedViewing}" Foreground="{DynamicResource Ink}" Margin="0,6">
                <StackPanel Margin="10,6,0,0">
                  <CheckBox x:Name="UsefulResize" Content="{DynamicResource Text.AllowResize}" Click="LayoutPreference_Click"/>
                  <CheckBox x:Name="ProtectEdges" Content="{DynamicResource Text.ProtectEdges}" Click="LayoutPreference_Click"/>
                  <CheckBox x:Name="AllowBleed" Content="{DynamicResource Text.AllowBleed}" Click="LayoutPreference_Click"/>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="BleedAmount" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="0,48" AutomationProperties.Name="{DynamicResource Text.MaxBleed}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.MaxBleed}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="ComfortWidth" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="480,2400" AutomationProperties.Name="{DynamicResource Text.ComfortWidth}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.ComfortWidth}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="ComfortHeight" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="320,1600" AutomationProperties.Name="{DynamicResource Text.ComfortHeight}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.ComfortHeight}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <CheckBox x:Name="Calibrate" Content="{DynamicResource Text.Calibrate}" Click="LayoutPreference_Click"/>
                  <StackPanel x:Name="CalibrationFields">
                    <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                      <TextBox x:Name="PhysicalWidth" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="150,4000" AutomationProperties.Name="{DynamicResource Text.DisplayWidth}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                      <TextBlock Text="{DynamicResource Text.DisplayWidth}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                      <TextBox x:Name="ViewDistance" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="200,3000" AutomationProperties.Name="{DynamicResource Text.ViewingDistance}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                      <TextBlock Text="{DynamicResource Text.ViewingDistance}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </StackPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
            <StackPanel x:Name="ClassicOptions">
              <Expander Header="{DynamicResource Text.AdvancedSnap}" Foreground="{DynamicResource Ink}" Margin="0,6" IsExpanded="False">
                <StackPanel Margin="10,6,0,0">
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="NeighborSnap" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="0,240" AutomationProperties.Name="{DynamicResource Text.NeighborSnap}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.NeighborSnap}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="AlignSnap" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="0,120" AutomationProperties.Name="{DynamicResource Text.EdgeAlignment}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.EdgeAlignment}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="ScreenSnap" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="0,240" AutomationProperties.Name="{DynamicResource Text.ScreenSnap}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.ScreenSnap}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="EdgeAdjust" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="0,480" AutomationProperties.Name="{DynamicResource Text.EdgeAdjust}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.EdgeAdjust}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="ResizeRatio" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="0,50" AutomationProperties.Name="{DynamicResource Text.ResizeLimit}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.ResizeLimit}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <DockPanel Margin="0,3" MaxWidth="360" HorizontalAlignment="Left" Width="320">
                    <TextBox x:Name="PassCount" DockPanel.Dock="Right" Width="76" MinHeight="26" Padding="5,3" Tag="1,5" AutomationProperties.Name="{DynamicResource Text.Passes}" LostKeyboardFocus="LayoutNumber_LostFocus" KeyDown="LayoutNumber_Key"/>
                    <TextBlock Text="{DynamicResource Text.Passes}" VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
            <CheckBox x:Name="RescueWindows" Content="{DynamicResource Text.RescueOffscreen}" Click="LayoutPreference_Click"/>
            <Button Content="{DynamicResource Text.ResetLayout}" Click="ResetLayout_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="KeysSection" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="18,0,10,14">
            <TextBlock Text="{DynamicResource Text.GlobalShortcuts}" Style="{StaticResource SectionTitle}" Margin="0,8,0,4"/>
            <TextBlock Text="{DynamicResource Text.ShortcutHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="178"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource Text.ShowMainWindow}" VerticalAlignment="Center"/>
              <TextBox x:Name="ShowKeyBox" Grid.Column="1" Margin="0,4" IsReadOnly="True" Tag="{DynamicResource Text.Unset}" PreviewKeyDown="Hotkey_KeyDown"/>
              <TextBlock Grid.Row="1" Text="{DynamicResource Text.ToggleActivePin}" VerticalAlignment="Center"/>
              <TextBox x:Name="PinKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,4" IsReadOnly="True" Tag="{DynamicResource Text.Unset}" PreviewKeyDown="Hotkey_KeyDown"/>
              <TextBlock Grid.Row="2" Text="{DynamicResource Text.ForceMinimize}" VerticalAlignment="Center"/>
              <TextBox x:Name="ParkKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,4" IsReadOnly="True" Tag="{DynamicResource Text.Unset}" PreviewKeyDown="Hotkey_KeyDown"/>
              <TextBlock Grid.Row="3" Text="{DynamicResource Text.RestoreAll}" VerticalAlignment="Center"/>
              <TextBox x:Name="RecoverKeyBox" Grid.Row="3" Grid.Column="1" Margin="0,4" IsReadOnly="True" Tag="{DynamicResource Text.Unset}" PreviewKeyDown="Hotkey_KeyDown"/>
              <TextBlock Grid.Row="4" Text="{DynamicResource Text.IncreaseOpacity}" VerticalAlignment="Center"/>
              <TextBox x:Name="UpKeyBox" Grid.Row="4" Grid.Column="1" Margin="0,4" IsReadOnly="True" Tag="{DynamicResource Text.Unset}" PreviewKeyDown="Hotkey_KeyDown"/>
              <TextBlock Grid.Row="5" Text="{DynamicResource Text.DecreaseOpacity}" VerticalAlignment="Center"/>
              <TextBox x:Name="DownKeyBox" Grid.Row="5" Grid.Column="1" Margin="0,4" IsReadOnly="True" Tag="{DynamicResource Text.Unset}" PreviewKeyDown="Hotkey_KeyDown"/>
              <TextBlock Grid.Row="6" Text="{DynamicResource Text.Arrange}" VerticalAlignment="Center"/>
              <TextBox x:Name="ArrangeKeyBox" Grid.Row="6" Grid.Column="1" Margin="0,4" IsReadOnly="True" Tag="{DynamicResource Text.Unset}" PreviewKeyDown="Hotkey_KeyDown"/>
            </Grid>
            <DockPanel Margin="0,12,0,0">
              <Button Content="{DynamicResource Text.FillDefaults}" Style="{StaticResource QuietButton}" Click="ResetHotkeys_Click" DockPanel.Dock="Left"/>
              <Button x:Name="ApplyKeysButton" Content="{DynamicResource Text.Apply}" HorizontalAlignment="Right" Click="ApplyHotkeys_Click" DockPanel.Dock="Right"/>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="DataSection" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="18,0,10,14">
            <TextBlock Text="{DynamicResource Text.ActivityRecords}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
            <TextBlock Text="{DynamicResource Text.RecordPrivacy}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,10"/>
            <CheckBox x:Name="RecordSwitch" Content="{DynamicResource Text.RecordActivity}" Click="RecordSwitch_Click"/>
            <TextBlock x:Name="RecordStatus" Style="{StaticResource MutedText}" Margin="0,4,0,10" TextWrapping="Wrap"/>
            <CheckBox x:Name="VisualSampling" Content="{DynamicResource Text.VisualSampling}" Click="LayoutPreference_Click"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="{DynamicResource Text.OpenDataFolder}" Click="OpenData_Click" Margin="0,0,8,0"/>
              <Button Content="{DynamicResource Text.ExportRecords}" Click="ExportData_Click" Margin="0,0,8,0"/>
              <Button Content="{DynamicResource Text.ClearRecordsEllipsis}" Click="ClearData_Click" Style="{StaticResource QuietButton}"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PlacementSection" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="18,0,10,14">
            <TextBlock Text="{DynamicResource Text.PlacementLearning}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
            <CheckBox x:Name="ReferenceEnabled" Content="{DynamicResource Text.UseRecordedHabits}" Click="LayoutPreference_Click"/>
            <TextBlock Text="{DynamicResource Text.LocalPlacementHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <CheckBox x:Name="ImportedPlacementEnabled" Content="{DynamicResource Text.UseImportedPlacement}" Click="LayoutPreference_Click"/>
            <TextBlock Text="{DynamicResource Text.ImportPlacementHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <Button Content="{DynamicResource Text.ImportPlacementRules}" HorizontalAlignment="Left" Click="ImportPlacement_Click"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="BehaviorSection" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="18,0,10,14">
            <TextBlock Text="{DynamicResource Text.BehaviorLearning}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
            <CheckBox x:Name="LearnBehaviorSwitch" Content="{DynamicResource Text.LearnBehaviorTiming}" Click="LearnBehavior_Click"/>
            <TextBlock Text="{DynamicResource Text.BehaviorLearningHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <StackPanel x:Name="BehaviorRulesPanel"/>
            <Button Content="{DynamicResource Text.ImportBehaviorRules}" HorizontalAlignment="Left" Click="ImportBehavior_Click" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
   </Grid>

   <Popup x:Name="AddPopup" PlacementTarget="{Binding ElementName=AddButton}" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Opened="AddPopup_Opened">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10" Width="430" MaxHeight="380" PreviewKeyDown="AddPopup_Key">
     <DockPanel>
      <TextBox x:Name="PickSearch" DockPanel.Dock="Top" Tag="{DynamicResource Text.SearchOpenWindows}" Margin="0,0,0,8" TextChanged="PickSearch_Changed" AutomationProperties.Name="{DynamicResource Text.ChooseWindow}"/>
      <ListBox x:Name="PickList">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="{DynamicResource Text.AddAndPin}" Style="{StaticResource QuietButton}" FontSize="12" Click="PickPinned_Click" ToolTip="{DynamicResource Text.AddAndPinHint}" IsEnabled="{Binding CanOperate}"/>
          <Button Style="{StaticResource RowTitleButton}" Padding="6,6" HorizontalContentAlignment="Stretch" Click="Pick_Click" IsEnabled="{Binding CanOperate}">
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="32"/>
             <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WindowAvatar}" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
             <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding ProcessName}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
           </Grid>
          </Button>
         </DockPanel>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
   </Popup>

   <Border x:Name="StatusBar" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,52" Padding="12,7" CornerRadius="8"
      Background="{DynamicResource Ink}" Visibility="Collapsed" MaxWidth="460" MouseLeftButtonDown="DismissStatus_Click">
    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Paper}" FontSize="12" TextWrapping="Wrap"/>
   </Border>
  </Grid>
 </Border>
</Window>
