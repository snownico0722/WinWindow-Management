<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>false</SelfContained>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets/WinWindow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinWindow</AssemblyName>
    <RootNamespace>WinWindow</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Windows 窗口管理工作台</Description>
    <Authors>snownico0722</Authors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/WinWindow.ico" />
    <EmbeddedResource Include="Assets/PinFeedback.wav" LogicalName="WinWindow.Resources.PinFeedback.wav" />
    <ProjectReference Include="../NeatWin.Layout/NeatWin.Layout.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NoFocusLossResourceDirectory)' != ''">
    <EmbeddedResource Include="$(NoFocusLossResourceDirectory)/NoFocusLoss.dll" LogicalName="WinWindow.Native.NoFocusLoss.x86.dll" />
    <EmbeddedResource Include="$(NoFocusLossResourceDirectory)/NoFocusLoss64.dll" LogicalName="WinWindow.Native.NoFocusLoss.x64.dll" />
  </ItemGroup>
</Project>
