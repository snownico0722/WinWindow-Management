<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets/WinWindow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinWindow</AssemblyName>
    <RootNamespace>WinWindow</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Windows 窗口管理工作台</Description>
    <Authors>snownico0722</Authors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/WinWindow.ico" />
    <EmbeddedResource Include="Assets/PinFeedback.wav" LogicalName="WinWindow.Resources.PinFeedback.wav" />
    <ProjectReference Include="../NeatWin.Layout/NeatWin.Layout.csproj" />
  </ItemGroup>
</Project>
