<Window x:Class="WinWindow.ManagedWindowControls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
 ShowActivated="False" ResizeMode="NoResize" UseLayoutRounding="True" Focusable="False">
  <Grid>
    <Border x:Name="TitleStrip" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource CardLine}"
      BorderThickness="1" CornerRadius="6" Padding="1">
      <UniformGrid Rows="1">
        <Button x:Name="Collapse" Style="{StaticResource RowIconButton}" Width="26" Height="25" Focusable="False"
          IsEnabled="{Binding CanOperate}" Click="Collapse_Click"
          ToolTip="{DynamicResource Text.CollapseToIcon}" AutomationProperties.Name="{DynamicResource Text.CollapseToIcon}">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WindowAvatar}" Width="22" Height="22"/>
        </Button>
        <ToggleButton x:Name="Pin" Style="{StaticResource IconToggle}" Width="26" Height="25" Focusable="False"
          IsEnabled="{Binding CanOperate}" IsChecked="{Binding Pinned, Mode=OneWay}" Click="Pin_Click"
          ToolTip="{DynamicResource Text.WindowPin}" AutomationProperties.Name="{DynamicResource Text.WindowPin}">
          <Path Data="M5.2,2.2 L10.8,2.2 M6,2.2 L6,6.8 L3.6,9.5 L12.4,9.5 L10,6.8 L10,2.2 M8,9.5 L8,14.5"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
        </ToggleButton>
        <ToggleButton x:Name="OpacityToggle" Style="{StaticResource IconToggle}" Width="26" Height="25" Focusable="False"
          IsEnabled="{Binding CanOperate}" Click="Opacity_Click" AutomationProperties.Name="{DynamicResource Text.ToggleTitlebarOpacity}">
          <Grid Width="16" Height="16">
            <Ellipse Width="12" Height="12" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Path Data="M8,2 A6,6 0 0 0 8,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
          </Grid>
        </ToggleButton>
      </UniformGrid>
    </Border>
    <Button x:Name="Badge" Visibility="Collapsed" Style="{StaticResource RowTitleButton}" Focusable="False" Cursor="Hand"
      IsEnabled="{Binding CanOperate}" Click="Restore_Click" ToolTip="{Binding Title}"
      AutomationProperties.Name="{DynamicResource Text.RestoreFromIcon}">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}"
        BorderThickness="2" CornerRadius="10" Width="46" Height="46">
        <Grid>
          <Image x:Name="BadgeIcon" Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="{Binding Initial}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Source, ElementName=BadgeIcon}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Button>
  </Grid>
</Window>
